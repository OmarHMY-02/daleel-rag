# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------
# Generation backend: "groq" (free hosted, default) or "ollama" (local offline)
LLM_BACKEND=groq

# --- Groq (free hosted inference; get a free key at https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Faster / higher rate limit alternative: llama-3.1-8b-instant

# --- Ollama (local offline dev path) ---
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# --- Retrieval / embeddings (sensible defaults; rarely need to change) ---
EMBED_MODEL=intfloat/multilingual-e5-small
CHROMA_DIR=chroma
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=75
